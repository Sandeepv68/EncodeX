{
  "name": "EncodeX",
  "version": "1.0.0-beta.2",
  "description": "Multimedia converter built on FFmpeg, React, TypeScript, and Electron",
  "main": "dist/main/index.js",
  "bin": {
    "encodex": "bin/encodex.js"
  },
  "scripts": {
    "prepare": "node scripts/generate-sentry-config.mjs",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run gen:sentry-config && npm run build:renderer && npm run build:main && npm run build:preload",
    "start": "electron .",
    "electron:dev": "concurrently -k \"npm run dev:renderer\" \"wait-on http://localhost:5173 && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && electron . --dev\"",
    "dev:start": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && concurrently -k \"npm run dev:renderer\" \"electron .\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\" \"scripts/**/*.{ts,tsx,mjs,js}\" \"*.{ts,mjs,js}\" \"bin/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\" \"scripts/**/*.{ts,tsx,mjs,js}\" \"*.{ts,mjs,js}\" \"bin/**/*.js\"",
    "lint": "eslint src/renderer",
    "lint:px": "eslint -c scripts/eslint.px.config.mjs src/renderer",
    "lint:colors": "eslint -c scripts/eslint.colors.config.mjs src/renderer",
    "lint:rem": "eslint -c scripts/eslint.rem.config.mjs src/renderer",
    "lint:inline-styles": "eslint -c scripts/eslint.inline-styles.config.mjs src/renderer",
    "lint:strings": "eslint -c scripts/eslint.strings.config.mjs src/renderer",
    "lint:strings:test": "node --test eslint-rules/no-hardcoded-strings.test.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:main && npm run typecheck:preload",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --silent",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests --silent",
    "test:e2e": "npm run build && vitest run --config e2e/vitest.e2e.config.ts",
    "test:e2e:real": "npm run build && vitest run --config e2e/vitest.e2e.real.config.ts --silent",
    "test:e2e:ci": "vitest run --config e2e/vitest.e2e.config.ts --silent",
    "test:e2e:real:ci": "vitest run --config e2e/vitest.e2e.real.config.ts --silent",
    "fetch:binaries": "node scripts/fetch-media-binaries.mjs",
    "gen:sentry-config": "node scripts/generate-sentry-config.mjs",
    "perf": "vitest run --config perf/vitest.perf.config.ts",
    "perf:phase1": "vitest run --config perf/vitest.perf.config.ts -- perf/conversion-benchmark.perf.test.ts perf/queue-concurrency.perf.test.ts perf/startup.perf.test.ts",
    "perf:phase2": "vitest run --config perf/vitest.perf.config.ts -- perf/process-lifecycle.perf.test.ts perf/memory-leak.perf.test.ts perf/large-file.perf.test.ts",
    "perf:phase3": "vitest run --config perf/vitest.perf.config.ts -- perf/ipc-overhead.perf.test.ts perf/cli-batch.perf.test.ts perf/extraction.perf.test.ts",
    "perf:generate-media": "node perf/fixtures/generate-media.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "docs:dev": "vitepress dev site",
    "docs:build": "npm run docs:rss && vitepress build site",
    "docs:preview": "vitepress preview site",
    "docs:blog": "node scripts/generate-blog.mjs",
    "docs:rss": "node scripts/generate-rss.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/material": "^9.2.0",
    "@sentry/electron": "^7.17.0",
    "chalk": "4.1.2",
    "cli-progress": "3.12.0",
    "commander": "^14.0.3",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "i18next": "^26.3.6",
    "mermaid": "^11.17.0",
    "ora": "5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.0.0",
    "simple-icons": "^16.28.0",
    "stylis-plugin-rtl": "^2.1.1",
    "vitepress-plugin-mermaid": "^2.0.17",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/chalk": "^2.2.4",
    "@types/cli-progress": "^3.11.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/ora": "^3.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@docsearch/react": "^3.9.0"
  },
  "build": {
    "appId": "com.openconverter.app",
    "productName": "EncodeX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "resources/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ffprobe-static",
        "to": "ffprobe-static",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/AppIcon.icon/Assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/AppIcon.icon/Assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/AppIcon.icon/Assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}

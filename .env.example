# EncodeX environment configuration (copy to .env and adjust).
# Never commit your real .env.

# ---- Error monitoring (Sentry) ---------------------------------------------
# When SENTRY_DSN is set, error/performance monitoring is enabled (subject to
# the in-app Settings toggle). Without a DSN the monitoring layer is a no-op.
SENTRY_DSN=
# Optional labels; sensible defaults are derived at runtime otherwise:
SENTRY_ENVIRONMENT=development
# Optional explicit provider override ('sentry' | 'noop'); auto-detects from DSN:
MONITORING_PROVIDER=

# ---- Usage analytics (Aptabase, swappable) ---------------------------------
# When APTABASE_APP_KEY is set, anonymous categorical usage events are enabled
# (subject to the same in-app Settings toggle as error reporting). Without a
# key the analytics layer is a no-op. App Keys look like A-US-... / A-EU-... /
# A-DEV-...; self-hosted deployments use A-SH-... and must set APTABASE_HOST.
# The key is baked into the packaged app at build time via gen:aptabase-config
# (real environment variables still win at runtime).
APTABASE_APP_KEY=
# ONLY for self-hosted Aptabase: API endpoint base URL. Leave empty on cloud.
APTABASE_HOST=
# Optional labels; sensible defaults are derived at runtime otherwise:
APTABASE_ENVIRONMENT=development
# Optional explicit provider override ('aptabase' | 'noop'); auto-detects from key:
ANALYTICS_PROVIDER=
# Optional per-group emission gate (comma-separated, D10) so a noisy group can
# be disabled without a release:
# lifecycle,onboarding,nav,convert,image,audio,cut,queue,profiles,settings,mcp,updates,hw,cli,ux
ANALYTICS_GROUPS=
# Set to 1 to watch the Aptabase SDK log event delivery in local dev:
APTABASE_DEBUG=

# ---- CI-only: production sourcemap upload ---------------------------------
# Required only for release builds that upload sourcemaps so stack traces are
# readable. Keep these out of developer machines.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Existing app variables ------------------------------------------------
VITE_APP_VERSION=1.0.0-beta.0

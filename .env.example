# EncodeX environment configuration (copy to .env and adjust).
# Never commit your real .env.

# ---- Error monitoring (Sentry) ---------------------------------------------
# When SENTRY_DSN is set, error/performance monitoring is enabled (subject to
# the in-app Settings toggle). Without a DSN the monitoring layer is a no-op.
SENTRY_DSN=
# Optional labels; sensible defaults are derived at runtime otherwise:
SENTRY_ENVIRONMENT=development
# Optional explicit provider override ('sentry' | 'noop'); auto-detects from DSN:
MONITORING_PROVIDER=

# ---- CI-only: production sourcemap upload ---------------------------------
# Required only for release builds that upload sourcemaps so stack traces are
# readable. Keep these out of developer machines.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Existing app variables ------------------------------------------------
VITE_APP_VERSION=1.0.0-beta.0
